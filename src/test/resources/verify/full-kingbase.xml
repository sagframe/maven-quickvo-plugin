<?xml version="1.0" encoding="UTF-8"?>
<quickvo xmlns="http://www.sagframe.com/schema/quickvo">
<property name="project.version" value="1.0.0"/>
<property name="project.name" value="full-verify"/>
<datasource name="demo" driver="com.kingbase8.Driver" url="jdbc:kingbase8://[::1]:54321/kingbase" username="system" schema="quickvo_demo" password="12345678ab"/>
<tasks dist="target/golden/gen/full-kingbase" encoding="UTF-8">
	<task active="true" author="verify" exclude=".*_p\d+$" include="^QS_\w+" datasource="demo">
		<entity package="com.fv.kingbase.entity" substr="Qs" name="#{subName}"/>
	</task>
</tasks>
<primary-key><table name="QS_STAFF" strategy="generator" generator="default"/></primary-key>
<cascade><table name="QS_LOG" update-cascade="delete" load="STATUS='A'"/></cascade>
</quickvo>
