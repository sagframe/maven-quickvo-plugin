<?xml version="1.0" encoding="UTF-8"?>
<quickvo xmlns="http://www.sagframe.com/schema/quickvo"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.sagframe.com/schema/quickvo https://sagframe.github.io/schema/quickvo.xsd">
	<!-- sqlserver方言实测配置(sqltoy-mssql25,1434端口) -->
	<property name="project.version" value="1.0.0" />
	<property name="project.name" value="quickvo-verify" />
	<datasource name="demo" driver="com.microsoft.sqlserver.jdbc.SQLServerDriver"
		url="jdbc:sqlserver://localhost:1434;encrypt=false;trustServerCertificate=true;loginTimeout=30;databaseName=master"
		schema="dbo" username="sa" password="Sqltoy@2026" />
	<tasks dist="target/golden/gen/sqlserver" encoding="UTF-8">
		<task active="true" author="quickvo-test" include="^QUICKVO_DEMO_\w+" datasource="demo" api-doc="swagger-v3">
			<entity package="com.quickvo.demo.mssql.entity" substr="QuickvoDemo" name="#{subName}" />
			<vo package="com.quickvo.demo.mssql.vo" substr="QuickvoDemo" name="#{subName}VO" />
		</task>
	</tasks>
	<primary-key>
		<table name="QUICKVO_DEMO_STAFF" strategy="generator" generator="default" />
	</primary-key>
	<cascade>
		<table name="QUICKVO_DEMO_STAFF_LOG" update-cascade="delete" load="STATUS=1" />
	</cascade>
</quickvo>
