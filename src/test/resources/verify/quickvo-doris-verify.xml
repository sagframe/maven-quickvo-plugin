<?xml version="1.0" encoding="UTF-8"?>
<quickvo xmlns="http://www.sagframe.com/schema/quickvo"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.sagframe.com/schema/quickvo https://sagframe.github.io/schema/quickvo.xsd">
	<property name="project.version" value="1.0.0" />
	<property name="project.name" value="quickvo-verify" />
	<datasource name="demo" driver="com.mysql.cj.jdbc.Driver" url="jdbc:mysql://localhost:9031/quickvo_demo?useUnicode=true&amp;characterEncoding=utf8&amp;useSSL=false&amp;allowPublicKeyRetrieval=true" catalog="quickvo_demo" username="root" password="" />
	<tasks dist="target/golden/gen/doris" encoding="UTF-8">
		<task active="true" author="quickvo-test" include="^QUICKVO_DEMO_\w+" datasource="demo">
			<entity package="com.quickvo.demo.doris.entity" substr="QuickvoDemo" name="#{subName}" />
		</task>
	</tasks>
	<primary-key>
		<table name="QUICKVO_DEMO_STAFF" strategy="generator" generator="default" />
	</primary-key>
</quickvo>
