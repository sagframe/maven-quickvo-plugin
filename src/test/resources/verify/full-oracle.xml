<?xml version="1.0" encoding="UTF-8"?>
<quickvo xmlns="http://www.sagframe.com/schema/quickvo">
<property name="project.version" value="1.0.0"/>
<property name="project.name" value="full-verify"/>
<datasource name="demo" driver="oracle.jdbc.OracleDriver"
	url="jdbc:oracle:thin:@//localhost:1521/FREEPDB1"
	schema="SYSTEM" username="system" password="Sqltoy@2026"/>
<tasks dist="target/golden/gen/full-oracle" encoding="UTF-8">
	<task active="true" author="verify" include="^QS_\w+" datasource="demo" api-doc="swagger-v3">
		<entity package="com.fv.ora.entity" substr="Qs" name="#{subName}"/>
		<vo package="com.fv.ora.vo" substr="Qs" name="#{subName}VO"/>
	</task>
</tasks>
<primary-key>
	<table name="QS_STAFF" strategy="generator" generator="default"/>
</primary-key>
<cascade>
	<table name="QS_LOG" update-cascade="delete" load="STATUS='A'"/>
</cascade>
</quickvo>
