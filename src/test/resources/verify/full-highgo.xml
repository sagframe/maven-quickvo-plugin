<?xml version="1.0" encoding="UTF-8"?>
<quickvo xmlns="http://www.sagframe.com/schema/quickvo">
<property name="project.version" value="1.0.0"/>
<property name="project.name" value="full-verify"/>
<!-- highgo(PG12内核)复用pg血缘通用QS_表脚本pgfamily-full.sql -->
<datasource name="demo" driver="com.highgo.jdbc.Driver" url="jdbc:highgo://localhost:5867/highgo" username="highgo" password="Sqltoy@2026" schema="quickvo_demo"/>
<tasks dist="target/golden/gen/full-highgo" encoding="UTF-8">
	<task active="true" author="verify" include="^QS_\w+" datasource="demo">
		<entity package="com.fv.highgo.entity" substr="Qs" name="#{subName}"/>
	</task>
</tasks>
<primary-key><table name="QS_STAFF" strategy="generator" generator="default"/></primary-key>
<cascade><table name="QS_LOG" update-cascade="delete" load="STATUS='A'"/></cascade>
</quickvo>
